<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Your changesets will go here -->
    <!-- Example first changeset: -->
    <changeSet id="1" author="sacco-dev">
        <createTable tableName="smoothsurf_sacco_saccos">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="registration_number" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="status" type="VARCHAR(20)" defaultValue="ACTIVE"/>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()"/>
        </createTable>
    </changeSet>

    <include file="db/changelog/002-user-management.xml" relativeToChangelogFile="false"/>
    <include file="db/changelog/003-user-avatar.xml" relativeToChangelogFile="false"/>
    <include file="db/changelog/004-invitation-flow.xml" relativeToChangelogFile="false"/>
    <include file="db/changelog/005-workflow-engine.xml" relativeToChangelogFile="false"/>
    <include file="db/changelog/006-workflow-engine-extensions.xml" relativeToChangelogFile="false"/>
    <include file="db/changelog/007-workflow-interface-key.xml" relativeToChangelogFile="false"/>
    <include file="db/changelog/008-loans.xml" relativeToChangelogFile="false"/>
    <include file="db/changelog/009-checklists.xml" relativeToChangelogFile="false"/>

</databaseChangeLog>